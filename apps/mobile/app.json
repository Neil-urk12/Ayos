{
  "expo": {
    "name": "ayos",
    "slug": "ayos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ayos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ayos.app",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.ayos.app",
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ayos uses your photos so you can attach a picture of the problem to your report.",
          "cameraPermission": "Ayos uses the camera so you can take a picture of the problem for your report."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D4ED8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "status-updates",
          "icon": "./assets/images/notification-icon.png",
          "color": "#1D4ED8"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ayos uses your location so the LGU knows where the reported problem is, and to show reports near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7654c01a-c0b7-412a-96d3-88b50ca1b3f8"
      }
    },
    "owner": "quivus"
  }
}
