# Copy to .env.local and fill in from Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Mapbox public token (pk.…) for the maps (console.mapbox.com > Access tokens > Default public token).
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Push notifications need google-services.json (Firebase console > Project settings > Your apps >
# Android app com.ayos.app). Put it in apps/mobile/ (gitignored), or set this to its path
# (e.g. an EAS file environment variable). Without it the app builds, but push is off.
# GOOGLE_SERVICES_JSON=./google-services.json
