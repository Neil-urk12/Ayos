{
  "name": "ayos-monorepo",
  "private": true,
  "scripts": {
    "mobile": "pnpm --filter mobile start",
    "web": "pnpm --filter web dev",
    "set-staff": "pnpm --filter web set-staff",
    "seed": "pnpm --filter web seed",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --project demo-ayos --only firestore,storage \"pnpm --filter rules test\"",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0"
  },
  "packageManager": "pnpm@12.14.0"
}
