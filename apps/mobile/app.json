{
  "expo": {
    "name": "ayos",
    "slug": "ayos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ayos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ayos.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.ayos.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ayos uses your photos so you can attach a picture of the problem to your report.",
          "cameraPermission": "Ayos uses the camera so you can take a picture of the problem for your report."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "status-updates",
          "color": "#208AEF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ayos uses your location so the LGU knows where the reported problem is, and to show reports near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
